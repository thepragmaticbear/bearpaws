#!/usr/bin/env bash
# Risk gate for Claude Code. Sends the agent back when pending edits have no risk
# receipt, or when elevated work is COMPLETE without a review after the last edit.
# Also blocks a Verified or Pinned line that claims a test run the log doesn't show, or whose last run failed.
# Modes: baseline (PreToolUse on Bash), record (PostToolUse, and PostToolUseFailure on Bash), stop (Stop).
# The log holds edits and test runs not yet accepted by a receipt; an allowing stop clears it,
# except elevated INCOMPLETE work with no review or with an open finding, which stays
# pending: a later reply with receipt lines is judged again, one without them passes.
# Design: docs/bearpaws/plans/2026-10-11-risk-gate-design.md
# tests/hooks/run-risk-gate-tests.sh pins every rule.

# No errexit: an internal failure must allow the turn, never block it.
set -uo pipefail

mode="${1:-}"
[ "${BEARPAWS_ENFORCE:-1}" = 0 ] && exit 0
# Claude Code only. Other harnesses that read hooks/hooks.json get a no-op.
[ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || exit 0
[ -z "${COPILOT_CLI:-}${CURSOR_PLUGIN_ROOT:-}${DEVIN_PROJECT_DIR:-}${DEVIN_PLUGIN_ROOT:-}" ] || exit 0
if ! command -v jq >/dev/null 2>&1; then
  echo "bearpaws risk-gate: jq not found, risk gate disabled" >&2
  exit 0
fi

input="$(cat)"
sid="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
# session_id becomes a file name: accept only a plain token.
[[ "$sid" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || exit 0
dir="${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}}/risk-gate"
log="$dir/$sid.log"
# The fallback may be a shared temp dir: owner-only, and refuse a dir or log someone else planted.
umask 077
mkdir -p "$dir" 2>/dev/null && [ -O "$dir" ] && [ ! -L "$dir" ] && [ ! -L "$log" ] || exit 0

# sensitive_paths() (one nudge per pending batch), LEAD, TRAIL and field(). Without it, allow.
. "$(dirname "${BASH_SOURCE[0]}")/lib-receipt" 2>/dev/null || exit 0
# Review description: starts with "review" (closed list of prefixes), not followed by a fix word.
REVIEW_DESC='^\W*((code|spec|final|security|independent|quality|plan|design|re)[\s-]+)*review(ing)?\b(?!\W*(fix|feedback|comment|finding|follow))'
# Test files: a tests/, test/ or __tests__/ directory, or a conventional test file name.
TESTFILE='(^|/)(tests?|__tests__)/|(^|/)(test_[^/]*\.py|[^/]*_test\.(py|go)|[^/]*\.(test|spec)\.(jsx?|tsx?|mjs|cjs)|[^/]*_spec\.rb|[^/]*Test\.java)$'
# Test run: a runner in command position (start, or after ; & | ( or a backtick), after optional
# VAR=value and wrappers. A command that only mentions one (echo pytest, cat tests/x.sh) is not a run.
# Its outcome is recorded below (test-run or test-fail). Newlines become ;, so a heredoc or
# commit-message line that starts with a runner name also counts as a run.
TR_POS='(^|[;&|(`])[[:space:]]*'
# Prefixes, each then whitespace: VAR=value, run/exec and plain wrappers, docker exec|run <ctr>; or sh -c.
TR_VAR='[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*'
TR_EXEC='(uv|poetry|pipenv|pdm|hatch|rye)[[:space:]]+run|npx|pnpx|bunx|uvx|(npm|pnpm|yarn|bun)[[:space:]]+exec|pnpm|yarn|bun|bundle[[:space:]]+exec'
TR_WRAP='time|nice|env|xvfb-run|rtk([[:space:]]+(test|proxy))?|timeout[[:space:]]+[0-9]+[smh]?'
TR_DOCKER='docker([[:space:]]+compose)?[[:space:]]+(exec|run)([[:space:]]+-[^[:space:]]+)*[[:space:]]+[^-[:space:]][^[:space:]]*'
TR_SHC='(bash|sh)[[:space:]]+-[a-z]*c[[:space:]]+['\''"]?'
TR_DIR='([^[:space:];&|]*/)?'
# Runners: bare tools, package-manager test, build-tool test, rake, test scripts and modules.
TR_RUN='pytest|py\.test|tox|nox|jest|vitest|mocha|rspec|phpunit|bats|ctest'
TR_PM='(npm|pnpm|yarn|bun)([[:space:]]+(--prefix|--dir|--cwd|-C)[[:space:]]+[^[:space:]]+)*([[:space:]]+run)?[[:space:]]+test(:[^[:space:];&|]*)?|npm[[:space:]]+t'
TR_BUILD='(go|cargo|mix|dotnet|deno|swift|mvn|mvnw|gradle|gradlew|make|bazel|just|rails|sbt|flutter|dart|lein|stack|cabal)([[:space:]]+-[^[:space:]]+)*[[:space:]]+test|cargo[[:space:]]+nextest'
TR_RAKE='rake([[:space:]]+-[^[:space:]]+)*([[:space:]]+(test|spec)(:[^[:space:];&|]*)?|[[:space:]]*$|[[:space:]]*[;&|)])'
TR_SCRIPT='(scripts?|bin)/tests?|python3?(\.[0-9]+)?[[:space:]]+-m[[:space:]]+(pytest|unittest)|node[[:space:]]+--test|((bash|sh|python3?)[[:space:]]+)?[^[:space:];&|]*tests?/[^[:space:];&|]*\.(sh|py)'
TR_END='([[:space:];&|)'\''"]|$)'
TESTRUN="$TR_POS(($TR_VAR|$TR_EXEC|$TR_WRAP|$TR_DOCKER)[[:space:]]+|$TR_SHC)*$TR_DIR($TR_RUN|$TR_PM|$TR_BUILD|$TR_RAKE|$TR_SCRIPT)$TR_END"
# A failure summary at the start of an output line (ANSI colors removed), for runs whose exit status
# a pipe, "|| true" or ";" may have hidden. One alternative per runner family: pytest, unittest,
# jest/vitest, go, cargo, rspec/bats, mocha, phpunit, node --test, ctest, and "N [NAME] TEST(S) FAILED"
# suites. Counts must be nonzero, so "0 failed", "# fail 0" and "0 TESTS FAILED" still pass.
TESTFAIL='^[=[:space:]]*([0-9]+ [a-z]+, )*[1-9][0-9]* (failed|errors?)(, [^=]*)? in [0-9.]+ ?(m?s|seconds)( \([0-9:]+\))?[[:space:]=]*$'
TESTFAIL+='|^FAILED \((failures|errors)=|^FAILED [^[:space:]]+::|^[[:space:]]*(Tests|Test Files):?[[:space:]]+([0-9]+ [a-z]+, )*[1-9][0-9]* failed'
TESTFAIL+='|^--- FAIL:|^FAIL'$'\t''|^(FAIL|ERROR): [A-Za-z_][A-Za-z0-9_]* \([A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+\)[[:space:]]*$|^test result: FAILED|^[0-9]+ (examples?|tests?), [1-9][0-9]* failures?|^[[:space:]]*[1-9][0-9]* failing[[:space:]]*$'
TESTFAIL+='|^(FAILURES|ERRORS)!|^(#|ℹ) fail [1-9]|^[0-9]+% tests passed, [1-9][0-9]* tests? failed|^[1-9][0-9]* ([A-Z-]+ )?TESTS?(\(S\))? FAILED'
# TAP: a "not ok" line is a failure unless its directive is # TODO or # SKIP (checked apart: ERE cannot negate).
TAPFAIL='^not ok [0-9]'
TAPOK='#[[:space:]]*(todo|skip)'
HIDES='[|;&]'
# A trailing lone & (not &&, |&, >& or &>) backgrounds the command: it has no result yet.
BG='(^|[^&>|])&$'

# Hash of path, size and mtime for every tracked or untracked, non-ignored file, listed from the
# toplevel. Ignores the index and HEAD, so git add and commit don't change it; sorted because
# staging reorders git's list. Content isn't hashed: a same-size edit within one mtime tick is missed.
fingerprint() { # <toplevel> <sha tool>
  local top="$1" files
  files="$(cd -- "$top" 2>/dev/null && git ls-files -co --exclude-standard -z 2>/dev/null | tr '\0' '\n')" || return 1
  # Excluded: caches and unambiguous test artifacts. Not dist/, build/ or coverage/: those can be real work.
  printf '%s\n' "$files" \
    | { grep -vE '^$|(^|/)(__pycache__|\.pytest_cache|node_modules|\.mypy_cache|\.ruff_cache|\.venv|htmlcov|\.hypothesis|\.tox|\.nox|\.eslintcache|\.coverage(\.[^/]*)?|[^/]*\.egg-info)(/|$)|\.pyc$' || true; } \
    | LC_ALL=C sort | tr '\n' '\0' \
    | (cd -- "$top" 2>/dev/null && {
        # GNU stat, else BSD with fractional seconds, else whole seconds. -- stops names like -f being options.
        if stat -c %s / >/dev/null 2>&1; then xargs -0 stat -c '%n %s %.9Y' --
        elif stat -f %Fm / >/dev/null 2>&1; then xargs -0 stat -f '%N %z %Fm' --
        else xargs -0 stat -f '%N %z %m' --; fi; } 2>/dev/null || true) | $2 | cut -d' ' -f1
}
# One fingerprint file per repo, kept across accepted stops. A Bash call that changes it is an edit;
# the first one for a repo only sets the baseline. Always returns 0.
track_tree() { # <cwd> <tool>
  local top sha fp last tree
  [ -n "$1" ] || return 0
  if command -v shasum >/dev/null 2>&1; then sha=shasum; elif command -v sha1sum >/dev/null 2>&1; then sha=sha1sum; else return 0; fi
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" && [ -n "$top" ] || return 0
  tree="$dir/$sid.$(printf '%s' "$top" | $sha | cut -c1-12).tree"
  [ ! -L "$tree" ] || return 0
  [ "$2" = baseline ] && [ -e "$tree" ] && return 0
  fp="$(fingerprint "$top" $sha)" && [ -n "$fp" ] || return 0
  last="$(cat "$tree" 2>/dev/null)"
  if [ "$2" = Bash ]; then
    [ "$last" = "$fp" ] && return 0
    [ -n "$last" ] && echo 'edit (bash)' >>"$log"
  fi
  # Atomic write: temp file, then rename.
  if printf '%s\n' "$fp" >"$tree.$$" 2>/dev/null; then mv -f "$tree.$$" "$tree" 2>/dev/null || rm -f "$tree.$$"; else rm -f "$tree.$$"; fi
  return 0
}

# Accept the pending work: clear the log, but keep a passing test run that followed the last edit,
# so the next turn's Pinned can rest on it.
accept() {
  # Only a pass that no later edit or failed run superseded.
  if awk '/^edit(-test)? /{e=NR} /^test-run$/{r=NR} /^test-fail$/{f=NR} END{exit !(r>e && r>f)}' "$log"; then
    echo test-run >"$log"; else rm -f "$log"; fi
  exit 0
}
block() { jq -cn --arg r "$1" '{hookSpecificOutput: {hookEventName: "Stop", additionalContext: $r}}'; exit 0; }
# Open: lists unfixed Critical/Important findings. 0: empty (none, n/a or blank), or absent on routine
# work; 1: absent on elevated work; 2: lists something.
open_state() { # <risk>
  local line
  # The first Open line after the last Risk line: prose before the receipt or notes after it don't count.
  line="$(awk -v re="${LEAD}Risk${TRAIL}:" 'tolower($0) ~ tolower(re) {r=NR} {l[NR]=$0} END{for(i=r;i<=NR;i++) print l[i]}' <<<"$msg" \
    | grep -iE "${LEAD}Open${TRAIL}:" | head -1)"
  if [ -z "$line" ]; then [ "$1" = elevated ] && return 1; return 0; fi
  grep -qiE '^[[:space:]]*((none|n/a)[.[:space:]]*)?$' <<<"$(tr -d '*_`' <<<"${line#*:}")" && return 0
  return 2
}
pend() { [ "$(tail -1 "$log")" = pending ] || echo pending >>"$log"; exit 0; }
OPEN_MISSING="Elevated work needs an Open line: Open: none, or each unfixed Critical or Important review finding with Status: INCOMPLETE."
OPEN_LISTED="Open: lists unfixed review findings, so the work is not COMPLETE. Fix each with its own failing test, or set Status: INCOMPLETE naming it. If nothing is open, write exactly Open: none."

OKW='(^|[^[:alnum:]])(pass(ed|es|ing)?|ok|green)([^[:alnum:]-]|$)'
NEG='(none|n/?a|n\.a|no|not|nothing|skip(ped)?)'
run_claim() { # <Verified value>: does any clause claim a test run?
  local c
  while IFS= read -r c; do
    grep -qiE "not run|not installed|unavailable|(did|could) ?n[o']t run|(^|[^0-9[:space:]])[[:space:]]*skipped([^=]|$)" <<<"$c" && continue
    [[ "${c//:/ }" =~ $TESTRUN ]] && return 0
    grep -qiE '(^|[^[:alnum:]])pass(ed|es|ing)?([^[:alnum:]-]|$)' <<<"$c" && grep -qiE 'test|spec|[0-9]' <<<"$c" && return 0
    grep -qiE '(^|[^[:alnum:]])(tests?|specs?|suites?)[[:space:]:]+((are|is|all|still)[[:space:]]+)?(ok|green)([^[:alnum:]-]|$)' <<<"$c" && return 0
    grep -qiE '(^|[^[:alnum:]])all [0-9]+ (green|ok)([^[:alnum:]]|$)' <<<"$c" && return 0
  done < <(tr ';,()' '\n\n\n\n' <<<"${1//. /$'\n'}")
  return 1
}

case "$mode" in
  baseline)
    # Fingerprint before the first Bash call so its own edit is seen. Must print nothing.
    track_tree "$(jq -r '.cwd // empty' <<<"$input")" baseline >/dev/null 2>&1
    ;;
  record)
    tool="$(jq -r '.tool_name // empty' <<<"$input")"
    case "$tool" in
      Edit|Write|MultiEdit|NotebookEdit)
        path="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$input")"
        # Relative to the session cwd, so a project dir named oauth-proxy does not look sensitive.
        cwd="$(jq -r '.cwd // empty' <<<"$input")"
        [ -n "$cwd" ] && path="${path#"$cwd"/}"
        # Claude's own config, memory, and plan files, and bearpaws' own reports (~/.bearpaws), are not project edits.
        [ -n "${HOME:-}" ] && case "$path" in "${HOME%/}"/.claude/*|"${HOME%/}"/.claude.json|"${HOME%/}"/.bearpaws/*) exit 0 ;; esac
        [ -n "${CLAUDE_CONFIG_DIR:-}" ] && case "$path" in "${CLAUDE_CONFIG_DIR%/}"/*) exit 0 ;; esac
        path="${path//$'\n'/ }"; path="${path//$'\r'/ }"
        if [ -n "$path" ]; then
          # Test-file edits are logged apart: Pinned needs a run only before the first non-test edit.
          if [[ "$path" != /* && "$path" != *../* && "$path" =~ $TESTFILE ]]; then printf 'edit-test %s\n' "$path" >>"$log"; else printf 'edit %s\n' "$path" >>"$log"; fi
        fi
        track_tree "$cwd" "$tool"
        ;;
      Bash)
        # Tree first: files the run itself writes land before its test-run line.
        track_tree "$(jq -r '.cwd // empty' <<<"$input")" Bash
        cmd="$(jq -r '.tool_input.command // empty' <<<"$input")"
        if [[ "${cmd//$'\n'/;}" =~ $TESTRUN ]]; then
          # A nonzero exit arrives as PostToolUseFailure. An exit of 0 is a pass unless the command could
          # hide the status and its output shows a failure summary. A background launch has no result yet.
          read -r event bg < <(jq -r '"\(.hook_event_name // "-") \(.tool_input.run_in_background // false)"' <<<"$input")
          # Trailing whitespace off for the & test; fd redirections (2>&1, &>) and && off for the hide test:
          # neither can hide a failing runner's exit status.
          flat="${cmd//$'\n'/;}"; trimmed="${flat%"${flat##*[![:space:];]}"}"; plain="${flat//>&/}"; plain="${plain//&>/}"; plain="${plain//&&/}"
          outcome=test-run
          if [ "$event" = PostToolUseFailure ]; then outcome=test-fail
          elif [ "$bg" = true ] || [[ "$trimmed" =~ $BG ]]; then outcome=""
          elif [[ "$plain" =~ $HIDES ]]; then
            # Capture first: grep -q exits at its first match, and under pipefail jq's SIGPIPE would hide it.
            out="$(jq -r '.tool_response | if type == "object" then [.stdout // "", .stderr // ""] | join("\n")
                          elif type == "string" then . else "" end | gsub("\u001b\\[[0-9;]*[A-Za-z]"; "")' <<<"$input" 2>/dev/null)"
            if grep -qE "$TESTFAIL" <<<"$out" || { grep -E "$TAPFAIL" <<<"$out" | grep -viE "$TAPOK" >/dev/null; }; then
              outcome=test-fail
            fi
          fi
          [ -n "$outcome" ] && echo "$outcome" >>"$log"
        fi
        ;;
      Agent|Task|SendMessage)
        # Reviewer subagent_type, or a matching description (SendMessage: summary, not to main). Never the prompt.
        if jq -e --arg re "$REVIEW_DESC" '.tool_input | ((.subagent_type // "" | tostring | test("\\breview"; "i"))
                  or ((if $tool == "SendMessage" then (if .to == "main" then null else .summary | strings end) else .description end) // "" | tostring | test($re; "i")))' --arg tool "$tool" <<<"$input" >/dev/null 2>&1; then
          echo review >>"$log"
        fi
        ;;
    esac
    ;;
  stop)
    [ -f "$log" ] && grep -qE '^edit(-test)? ' "$log" || exit 0
    msg="$(jq -er '.last_assistant_message | strings' <<<"$input" 2>/dev/null)" || exit 0
    if field Risk elevated; then risk=elevated
    elif field Risk routine; then risk=routine
    # Pending from an earlier INCOMPLETE, nothing since, and no receipt now: an unrelated reply passes.
    elif [ "$(tail -1 "$log")" = pending ] && ! grep -qiE "${LEAD}(Risk|Status)${TRAIL}:" <<<"$msg"; then exit 0
    else block "Edits are pending without a risk receipt. End with one: Risk: routine or Risk: elevated (surface), then Verified, Not checked and Status lines (elevated work adds Pinned, Failing first, Review, Open, Assumptions). See bp:verification-before-completion."
    fi
    # Only the last Status line counts, and INCOMPLETE must be its value.
    grep -iE "${LEAD}Status${TRAIL}:" <<<"$msg" | tail -1 | grep -qiE "Status${TRAIL}:[*_\`[:space:]]*INCOMPLETE" && incomplete=1 || incomplete=0
    # Line numbers: the last edit of any kind (test edits included), the first non-test edit, test runs.
    last_edit="$(grep -nE '^edit(-test)? ' "$log" | tail -1 | cut -d: -f1)"
    # Bash edits carry no path and may be the failing test, so they count only when nothing else does.
    first_edit="$(grep -n '^edit ' "$log" | grep -vF ':edit (bash)' | head -1 | cut -d: -f1)"
    [ -n "$first_edit" ] || first_edit="$(grep -nE '^edit(-test)? ' "$log" | head -1 | cut -d: -f1)"
    # One pass over the log: first and last passing run, last failed run, and whether the last run
    # before any edit failed (a pass that a later failure superseded does not pin; the failing-first
    # run after a test edit is expected and does not unpin).
    read -r first_run last_run last_fail pin_failed < <(awk '
      /^edit(-test)? / { if (!fa) fa = NR }
      /^test-run$/  { if (!fr) fr = NR; lr = NR; if (!fa) lb = "run" }
      /^test-fail$/ { lf = NR; if (!fa) lb = "fail" }
      END { print fr + 0, lr + 0, lf + 0, (lb == "fail") }' "$log")
    [ "$first_run" -gt 0 ] || first_run="$first_edit"
    # Verified claims a run when any clause (split on ; , ( ) and ". ") names a runner, says passed next
    # to test/spec or a count, or says "tests ok", "suite green" or "all 41 green", and that clause
    # does not say the run did not happen ("1 skipped" and "skipped=2" are counts, not cancels).
    verified="$(grep -iE "${LEAD}Verified${TRAIL}:" <<<"$msg" | tail -1)"
    # Honest incompleteness is never blocked, so both claim checks apply only to COMPLETE.
    if [ "$incomplete" = 0 ] && [[ -n "$verified" ]] && run_claim "${verified#*:}"; then
      if [ "$last_fail" -gt "$last_edit" ] && [ "$last_fail" -gt "$last_run" ]; then
        block "Verified: claims a test run, but the last test run after the edit failed (nonzero exit, or a failure summary in its output). Fix and rerun, or say Status: INCOMPLETE."
      elif [ "$last_run" -le "$last_edit" ]; then
        block "Verified: claims a test run, but none ran after the last edit. Run the tests now, or say what you actually checked."
      fi
    fi
    # Pinned (its last line) claims a run unless it starts with none, n/a, no, not, nothing, skipped,
    # "there were no" or a dash, or says one of those anywhere and no pass/ok/green; it must precede
    # the first non-test edit.
    pinned="$(grep -iE "${LEAD}Pinned${TRAIL}:" <<<"$msg" | tail -1)"; pinned="${pinned#*:}"
    if [ "$incomplete" = 0 ] && [[ "$pinned" =~ [^*_\`[:space:]] ]] \
       && ! grep -qiE '^[*_`[:space:](]*((none|n/?a|n\.a\.?|no|not|nothing|skip(ped)?|there (were|was|are|is) no)([^[:alnum:]]|$)|(-|—)([[:space:]]|$))' <<<"$pinned" \
       && ! { grep -qiE "(^|[^[:alnum:]])$NEG([^[:alnum:]]|$)" <<<"$pinned" && ! grep -qiE "$OKW" <<<"$pinned"; } \
       && { [ "$first_run" -ge "$first_edit" ] || [ "$pin_failed" = 1 ]; }; then
      block "Pinned: claims tests passed before the edit, but no passing test run was logged before the first edit (none ran, or the last one failed). Correct the line: Pinned: none, and why."
    fi
    if [ "$risk" = elevated ]; then
      # The review must follow the last edit of any kind: a test edit can weaken what the review saw.
      last_review="$(grep -n '^review$' "$log" | tail -1 | cut -d: -f1)"
      if [ "${last_review:-0}" -gt "$last_edit" ]; then
        open_state elevated; o=$?
        # An open finding under INCOMPLETE stays pending, so a later COMPLETE is judged again.
        [ "$o" = 2 ] && [ "$incomplete" = 1 ] && pend
        [ "$incomplete" = 1 ] || { [ "$o" = 1 ] && block "$OPEN_MISSING"; [ "$o" = 2 ] && block "$OPEN_LISTED"; }
        accept
      fi
      # Elevated INCOMPLETE without a review stays pending.
      [ "$incomplete" = 1 ] && pend
      block "Elevated-risk work needs an independent review dispatched after the last edit. Dispatch one (bp:requesting-code-review), or set Status: INCOMPLETE."
    fi
    [ "$incomplete" = 1 ] || { open_state routine || block "$OPEN_LISTED"; }
    [ "$incomplete" = 1 ] && accept
    grep -qx nudged "$log" && accept
    hits="$(grep -E '^edit(-test)? ' "$log" | sed -E 's/^edit(-test)? //' | sensitive_paths | sort -u | head -5 | tr '\n' ' ')"
    [ -n "$hits" ] || accept
    echo nudged >>"$log"
    block "Edited ${hits}look elevated-risk. Reclassify as Risk: elevated, or keep routine and say why in the receipt."
    ;;
esac
exit 0
